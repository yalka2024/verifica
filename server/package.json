{
  "name": "verifica-server",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch worker.js",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && npm run db:rls && node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:rls": "node prisma/apply-rls.js",
    "db:rag": "node prisma/apply-rag.js",
    "db:backup": "node scripts/db-backup.js",
    "db:backup:list": "node scripts/db-backup.js --list",
    "db:backup:prune": "node scripts/db-backup.js --prune-only",
    "db:restore": "node scripts/db-restore.js",
    "stripe:setup": "node scripts/stripe-setup.js",
    "stripe:setup:dry": "node scripts/stripe-setup.js --dry-run",
    "email:test": "node -e \"require('./lib/email').sendTemplate('test', process.env.EMAIL_TO || 'test@example.com', { sent_at: new Date().toISOString() }).then(r => console.log(JSON.stringify(r))).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:runtime": "node scripts/runtime-smoke-isolated.js",
    "eval": "node scripts/eval-gate.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "prisma": "7.10.0",
    "rate-limit-redis": "^4.2.0",
    "stripe": "^22.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.23.8",
    "@sendgrid/mail": "^8.1.6",
    "resend": "^4.0.1",
    "openai": "^6.34.0",
    "@anthropic-ai/sdk": "^0.133.0",
    "prom-client": "^15.1.3",
    "@sentry/node": "^10.69.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}

